# Copy to .env and fill in. Never commit .env.
# AWS credentials come from the named profile in ~/.aws, not from this file.
AWS_PROFILE=demandpulse
AWS_REGION=us-east-1
DEMANDPULSE_S3_BUCKET=demandpulse-<account-id>-use1
# Set to a local directory to run the pipeline against local Parquet (tests, offline work).
# Leave empty to use S3.
DEMANDPULSE_LOCAL_DATA_ROOT=
